# Variables para docker compose (stack web Mapero)
# Copiar a .env y ajustar. En producción usar valores seguros.
POSTGRES_PASSWORD=mapero_dev
API_KEY=mapero_dev_key
PORT=8080
# Vacío = same-origin (lo normal: el front lo sirve el mismo backend).
# Solo si la web vive en otro dominio: CORS_ORIGIN=https://tu-dominio.example
CORS_ORIGIN=
# Primer administrador: el usuario debe existir. Solo se promueve si la base
# todavía no tiene ningún admin, así que no alcanza con registrar ese nombre.
ADMIN_USER=
