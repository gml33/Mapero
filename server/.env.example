# Configuración del servidor Mapero (no versionar secretos reales)
PORT=8080

# Conexión a PostgreSQL
DATABASE_URL=postgres://mapero:mapero_dev@localhost:5432/mapero

# Clave API de escritura usada por la app Android
API_KEY=mapero_dev_key

# Origen permitido para CORS. Vacío = same-origin, que es lo normal.
# Solo si el front se sirve desde otro dominio:
# CORS_ORIGIN=https://tu-dominio.example
CORS_ORIGIN=
